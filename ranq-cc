#!/usr/bin/env raku
enum TokenType <
    Identifier
    Constant
    IntT
    VoidT
    Return
    OpenParen
    CloseParen
    OpenBrace
    CloseBrace
    Semicolon
>;

class Token {
    has TokenType $.type is required;
    has Str $.lexeme;
}

class Tokenizer {
    my %keywords = int => IntT, void => VoidT, return => Return; 

    has Int $!idx = 0;
    has Str $!text is built;

    method push(Match $match, TokenType $type?) {
        $!idx += $match.to - $match.from;
        with $type {
            take Token.new(type => $type, lexeme => "$match");
        }
    }

    method empty() {
        return $!idx >= $!text.chars;
    }

    method text() {
        return $!text.substr($!idx);
    }

    method parse(Str $text) {
        my $this = self.new(text => $text);

        gather {
            while (!$this.empty) {
                given $this.text {
                    when /^\s+/ {
                        $this.push($/);
                    }
                    when /^<[a..zA..Z_]>+/ {
                        if %keywords«"$/"»:exists {
                            $this.push($/, %keywords«"$/"»);
                        } else {
                            $this.push($/, Identifier);
                        }
                    }
                    when /^<[0..9]>+/ {
                        $this.push($/, Constant);
                    }
                    when /^\(/ {
                        $this.push($/, OpenParen);
                    }
                    when /^\)/ {
                        $this.push($/, CloseParen);
                    }
                    when /^\}/ {
                        $this.push($/, CloseBrace);
                    }
                    when /^\{/ {
                        $this.push($/, OpenBrace);
                    }
                    when /^\;/ {
                        $this.push($/, Semicolon);
                    }
                    default {
                        say "Unrecognized character at $_";
                    }
                }
            }
        }
    }
}

for Tokenizer.parse(slurp @*ARGS[0]) -> $token {
    print $token.type;
    with $token.lexeme {
        print ": {$token.lexeme}";
    }
    say "";
}
