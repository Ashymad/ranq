#!/usr/bin/env raku

use lib "src";
use lex;
use parse;

my @stages = 'lex', 'parse', 'codegen', 'assemble';

my $end = @*ARGS[0];

if !@stages.first($end) {
    say "Couldn't find stage: $end, has to be one of: {@stages}";
    exit 2;
}

sub printok(@tokens) {
    for @tokens -> $token {
	"%-15s %s\n".printf($token.type, $token.lexeme);
    }
}

my @tokens;
my $data;

for @stages -> $stage {
    given $stage {
	when 'lex' {
	    @tokens = Lexer.lex(slurp @*ARGS[1]);
	}
	when 'parse' {
	    $data = Parser.parse(@tokens);
	}
	when 'codegen' {
	    $data = $data.gen;
	}
	when 'assemble' {
	    $data = $data.asm;
	}
    }

    if $stage eq $end {
	if $stage eq 'lex' {
	    printok @tokens;
	} else {
	    say "$data";
	}
	last;
    }
}
