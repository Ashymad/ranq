#!/bin/bash

set -e

endstage=link

while :; do
    case $1 in
        --lex) endstage=lex ;;
        --parse) endstage=parse ;;
        --codegen) endstage=codegen ;;
        -S) endstage=assemble ;;
        -*) echo "Unknown option: $1"; exit 1 ;;
        '') break ;;
        *) file="$1" ;;
    esac
    shift
done

CPP="${CPP:-gcc -E -P}"
ASM="${ASM:-gcc -x asm}"
CC1="${CC1:-$PWD/ranq-cc}"

OUT="${file%.*}"

$CC1 "$endstage" <($CPP "$file") -o "$OUT.s"

if [ "$endstage" = link ]; then
    $ASM "$OUT.s" -o "$OUT"
    rm "$OUT.s"
fi
