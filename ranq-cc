#!/usr/bin/env raku
enum TokenType <
    t_ident
    t_const
    t_int
    t_void
    t_return
    t_paren_l
    t_paren_r
    t_brace_l
    t_brace_r
    t_semicolon
>;

class Token {
    has TokenType $.type is required;
    has Str $.lexeme;
}

class Tokenizer {
    my %keywords = int => t_int, void => t_void, return => t_return; 

    has Str $.text is required is rw;

    method push(Match $match, TokenType $type?) {
        $.text .= substr($match.to);
        with $type {
            take Token.new(type => $type, lexeme => "$match");
        }
    }

    method empty() {
        return $.text.chars == 0;
    }

    method parse(Str $text) {
        my $this = self.new(text => $text);

        gather {
            while (!$this.empty) {
                given $this.text {
                    when /^\s+/ {
                        $this.push($/);
                    }
                    when /^<[a..zA..Z_]>+/ {
                        if %keywords«"$/"»:exists {
                            $this.push($/, %keywords«"$/"»);
                        } else {
                            $this.push($/, t_ident);
                        }
                    }
                    when /^<[0..9]>+/ {
                        $this.push($/, t_const);
                    }
                    when /^\(/ {
                        $this.push($/, t_paren_l);
                    }
                    when /^\)/ {
                        $this.push($/, t_paren_r);
                    }
                    when /^\{/ {
                        $this.push($/, t_brace_l);
                    }
                    when /^\}/ {
                        $this.push($/, t_brace_r);
                    }
                    when /^\;/ {
                        $this.push($/, t_semicolon);
                    }
                    default {
                        say "Unrecognized character at $_";
                    }
                }
            }
        }
    }
}

for Tokenizer.parse(slurp @*ARGS[0]) -> $token {
    say "{$token.type}(\"{$token.lexeme}\")";
}
