#!/bin/bash

set -e

endstage=link

while :; do
    case $1 in
        --lex) endstage=lex ;;
        --parse) endstage=parse ;;
        --codegen) endstage=codegen ;;
        -S) endstage=assemble ;;
        -*) echo "Unknown option: $1"; exit 1 ;;
        '') break ;;
        *) file="$1" ;;
    esac
    shift
done

CPP="${CPP:-gcc -E -P}"
ASM="${ASM:-gcc -x assembler}"
CC1="${CC1:-$PWD/ranq-cc}"

OUT="${file%.*}"

if [ "$endstage" = link ]; then
    $CC1 "assemble" <($CPP "$file") | $ASM - -o "$OUT"
else
    $CC1 "$endstage" <($CPP "$file")
fi
