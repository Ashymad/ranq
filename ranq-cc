#!/usr/bin/env raku

use lib "src";
use lex;
use parse;

given @*ARGS[0] {
    when "lex" {
        for Lexer.parse(slurp @*ARGS[1]) -> $token {
            "%-10s %-10s\n".printf($token.type, $token.lexeme);
        }
    }
    when "parse" {
        say "{Parser.parse(Lexer.parse(slurp @*ARGS[1]))}"
    }
    default {
        say "Unsupported mode: $_"
    }
}
